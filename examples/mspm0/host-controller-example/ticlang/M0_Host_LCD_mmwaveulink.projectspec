<?xml version="1.0" encoding="UTF-8"?>
<projectSpec>
    <applicability>
        <when>
            <context
                deviceFamily="ARM"
                deviceId="MSPM0L2228"
            />
        </when>
    </applicability>

    <project
        title="MMWAVE_Host"
        name="MMWAVE_Host_LP_MSPM0L2228_ticlang"
        configurations="Debug"
        toolChain="TICLANG"
        connection="TIXDS110_Connection.xml"
        device="MSPM0L2228"
        ignoreDefaultDeviceSettings="true"
        ignoreDefaultCCSSettings="true"
        products="MSPM0-SDK;sysconfig"
        compilerBuildOptions="
            -I${PROJECT_ROOT}
            -I${PROJECT_ROOT}/${ConfigName}
            -D__MSPM0L2228__
            -O2
            -I${COM_TI_MSPM0_SDK_INSTALL_DIR}/source/third_party/CMSIS/Core/Include
            -I${COM_TI_MSPM0_SDK_INSTALL_DIR}/source
            -I${COM_TI_MSPM0_SDK_INSTALL_DIR}/source/ti/driverlib
            -I${uDFP_INSTALL_DIR}
            -I${uDFP_INSTALL_DIR}/Host/mmWaveUlink
            -I${uDFP_INSTALL_DIR}/Host/mmWaveUlink/radarlink
            -gdwarf-3
            -mcpu=cortex-m0plus
            -march=thumbv6m
            -mfloat-abi=soft
            -mthumb
        "
        linkerBuildOptions="
            -L${PROJECT_BUILD_DIR}/syscfg
            -l${COM_TI_MSPM0_SDK_INSTALL_DIR}/source/ti/driverlib/lib/ticlang/m0p/mspm0l122x_l222x/driverlib.a
            -Wl,--rom_model
            -Wl,--warn_sections
            -L${CG_TOOL_ROOT}/lib
            -llibc.a
        "
        enableSysConfigTool="true"
        sysConfigBuildOptions="
            --product ${COM_TI_MSPM0_SDK_INSTALL_DIR}/.metadata/product.json
            --compiler ticlang
        "
        sourceLookupPath="${COM_TI_MSPM0_SDK_INSTALL_DIR}/source/ti/driverlib"
        description=" MMWAVE ULink Host ">

        <pathVariable name="ORIG_MODULES_ROOT_DIR" path="../" scope="project"/>
        <pathVariable name="uDFP_INSTALL_DIR" path="" scope="project"/>

        <property name="buildProfile" value="release"/>
        <property name="isHybrid" value="true"/>
        <file path="${ORIG_MODULES_ROOT_DIR}/main.c" openOnCreation="false" excludeFromBuild="false" action="link" >
        </file>
        <file path="${ORIG_MODULES_ROOT_DIR}/mmwave_host_lcd.syscfg" openOnCreation="false" excludeFromBuild="false" action="link" >
        </file>
        <file path="${ORIG_MODULES_ROOT_DIR}/mspm0_hal.c" openOnCreation="false" excludeFromBuild="false" action="link" >
        </file>
        <file path="${ORIG_MODULES_ROOT_DIR}/mspm0_hal.h" openOnCreation="false" excludeFromBuild="false" action="link" >
        </file>
        <file path="${uDFP_INSTALL_DIR}/Host/mmWaveUlink/mmwaveulink.c" openOnCreation="false" excludeFromBuild="false" action="link">
        </file>
        <file path="${uDFP_INSTALL_DIR}/Host/mmWaveUlink/radarlink/radarlink.c" openOnCreation="false" excludeFromBuild="false" action="link">
        </file>

    </project>
</projectSpec>